#!/bin/bash
# block-ping: drop incoming ICMP/ICMPv6 echo requests on the server's uplink interface(s).
# Works the same with or without ufw/firewalld: it uses its own nftables table (inet, hook
# input, priority -10), which runs before any other firewall and does not touch their rules.
# Only echo-request is dropped; every other ICMP type (errors, path MTU, neighbour discovery) stays.
# Run as root.
#
#   block-ping on [--wan-if IF[,IF...]]   block ping now and after every reboot (default: uplink from the default route)
#   block-ping off                        remove the block completely
#   block-ping status                     show whether it is active, on which interfaces, and how many pings were dropped
#
#   curl -fsSL https://raw.githubusercontent.com/thejohnd0e/awg-vps-kit/master/block-ping | bash -s -- on
set -euo pipefail

DIR=/etc/block-ping
RULES=$DIR/rules.nft
UNIT=/etc/systemd/system/block-ping.service
TFAM=inet; TNAME=block_ping   # nft table "inet block_ping"

usage() {
cat <<'EOT'
block-ping - drop incoming ICMP/ICMPv6 echo requests on the uplink (run as root)

  block-ping on [--wan-if IF[,IF...]]   block ping now and after reboot (default: uplink from the default route)
  block-ping off                        remove the block completely
  block-ping status                     active or not, interfaces, number of dropped pings

Own nftables table (inet, input hook, priority -10): works with or without ufw/firewalld and does
not touch their rules. Only echo-request is dropped; other ICMP types stay.
EOT
}
die() { echo "error: $*" >&2; exit 1; }

cmd=${1:-help}; shift || true
case "$cmd" in help|-h|--help) usage; exit 0 ;; esac
case "$cmd" in on|off|status) ;; *) usage >&2; exit 1 ;; esac

WAN=
while [ $# -gt 0 ]; do
  case "$1" in
    --wan-if) WAN=${2:-}; [ -n "$WAN" ] || die "--wan-if needs a value"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done

[ "$(id -u)" = 0 ] || die "run as root"

detect_wan() {  # uplink interfaces from the IPv4 and IPv6 default routes, space separated, unique
  { ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null; } \
    | awk '{for(i=1;i<NF;i++) if($i=="dev") print $(i+1)}' | sort -u | tr '\n' ' '
}

case "$cmd" in
  status)
    if nft list table "$TFAM" "$TNAME" >/dev/null 2>&1; then
      echo "ping block: ACTIVE"
      nft list table "$TFAM" "$TNAME" | grep -E 'echo-request' | sed 's/^[[:space:]]*/  /'
    else
      echo "ping block: not active"
    fi
    echo "boot: $(systemctl is-enabled block-ping 2>/dev/null || echo disabled)"
    exit 0 ;;
  off)
    systemctl disable --now block-ping >/dev/null 2>&1 || true
    nft delete table "$TFAM" "$TNAME" 2>/dev/null || true
    rm -f "$UNIT" "$RULES"; rmdir "$DIR" 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    echo "ping block removed"
    exit 0 ;;
esac

# on
command -v systemctl >/dev/null || die "systemd is required"
if ! command -v nft >/dev/null; then
  command -v apt-get >/dev/null || die "nft is not installed and apt-get is not available: install nftables first"
  echo "installing nftables..."
  apt-get install -y -qq nftables >/dev/null || die "could not install nftables"
fi

IFS_LIST=$(echo "${WAN:-$(detect_wan)}" | tr ',' ' ' | xargs -n1 2>/dev/null | sort -u | tr '\n' ' ')
[ -n "${IFS_LIST// /}" ] || die "no uplink interface found (no default route); use --wan-if IF"
read -ra IFARR <<<"$IFS_LIST"
for i in "${IFARR[@]}"; do
  [[ "$i" =~ ^[A-Za-z0-9_.:@-]{1,15}$ ]] || die "bad interface name: $i"
  [ -e "/sys/class/net/$i" ] || echo "warning: interface $i does not exist right now (the rule matches it by name)" >&2
done
SET=$(printf '"%s", ' "${IFARR[@]}"); SET=${SET%, }

mkdir -p "$DIR"
cat > "$RULES" <<EOF
# generated by block-ping: drops incoming echo requests on: $IFS_LIST
table $TFAM $TNAME
flush table $TFAM $TNAME
table $TFAM $TNAME {
	chain input {
		type filter hook input priority -10; policy accept;
		iifname { $SET } icmp type echo-request counter drop
		iifname { $SET } icmpv6 type echo-request counter drop
	}
}
EOF
nft -c -f "$RULES" || die "generated rules are invalid: $RULES"

cat > "$UNIT" <<EOF
[Unit]
Description=Drop incoming ICMP echo requests on the uplink (block-ping)
After=network-pre.target nftables.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f $RULES
ExecReload=/usr/sbin/nft -f $RULES
ExecStop=-/usr/sbin/nft delete table $TFAM $TNAME

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable block-ping >/dev/null 2>&1
systemctl restart block-ping
echo "ping block ACTIVE on: $IFS_LIST (also after reboot)"
echo "note: ping-based monitoring of this server will report it as down. Undo: block-ping off"
