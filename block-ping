#!/usr/bin/env bash
# block-ping: drop incoming ICMP/ICMPv6 echo requests on the server's uplink interface(s).
# Works the same with or without ufw/firewalld: it uses its own nftables table (inet, hook
# input, priority -10), which runs before any other firewall and does not touch their rules.
# Only echo-request is dropped; every other ICMP type (errors, path MTU, neighbour discovery) stays.
# Run as root.
#
#   block-ping on [--wan-if IF[,IF...]]   block ping now and after every reboot (default: uplink from the default route)
#   block-ping off                        remove the block completely
#   block-ping status                     show whether it is active, on which interfaces, and how many pings were dropped
#
#   curl -fsSL https://raw.githubusercontent.com/thejohnd0e/xray-vps-kit/master/block-ping | bash -s -- on
set -euo pipefail

DIR=${BLOCK_PING_DIR:-/etc/block-ping}
UNIT=${BLOCK_PING_UNIT:-/etc/systemd/system/block-ping.service}
APPLY=$DIR/apply          # generated helper: detects the uplink, writes the rules, loads them
WANFILE=$DIR/wan-if       # present only when the interfaces were chosen explicitly with --wan-if
RULES=$DIR/rules.nft
TFAM=inet; TNAME=block_ping   # nft table "inet block_ping"

usage() {
cat <<'EOT'
block-ping - drop incoming ICMP/ICMPv6 echo requests on the uplink (run as root)

  block-ping on [--wan-if IF[,IF...]]   block ping now and after reboot (default: uplink from the default route)
  block-ping off                        remove the block completely
  block-ping status                     active or not, interfaces, number of dropped pings

Own nftables table (inet, input hook, priority -10): works with or without ufw/firewalld and does
not touch their rules. Only echo-request is dropped; other ICMP types stay. Without --wan-if the
uplink is detected again on every start, reload and boot.
EOT
}
die() { echo "error: $*" >&2; exit 1; }

cmd=${1:-help}; shift || true
case "$cmd" in help|-h|--help) usage; exit 0 ;; esac
case "$cmd" in on|off|status) ;; *) usage >&2; exit 1 ;; esac

WAN=
while [ $# -gt 0 ]; do
  case "$1" in
    --wan-if) [ "$cmd" = on ] || die "--wan-if is only valid with: on"
              WAN=${2:-}; [ -n "$WAN" ] || die "--wan-if needs a value"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done

[ "$(id -u)" = 0 ] || die "run as root"

detect_wan() {  # uplink interfaces from the IPv4 and IPv6 default routes, space separated, unique
  { ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null; } \
    | awk '{for(i=1;i<NF;i++) if($i=="dev") print $(i+1)}' | sort -u | tr '\n' ' '
}

case "$cmd" in
  status)
    if nft list table "$TFAM" "$TNAME" >/dev/null 2>&1; then
      echo "ping block: ACTIVE"
      nft list table "$TFAM" "$TNAME" | grep -E 'echo-request' | sed 's/^[[:space:]]*/  /'
    else
      echo "ping block: not active"
    fi
    if [ -s "$WANFILE" ]; then echo "interfaces: $(tr ',' ' ' < "$WANFILE") (fixed)"
    elif [ -e "$APPLY" ]; then echo "interfaces: detected from the default route at every start"; fi
    echo "boot: $(systemctl is-enabled block-ping 2>/dev/null || echo disabled)"
    exit 0 ;;
  off)
    systemctl disable --now block-ping >/dev/null 2>&1 || true
    nft delete table "$TFAM" "$TNAME" 2>/dev/null || true
    rm -f "$UNIT" "$APPLY" "$WANFILE" "$RULES"; rmdir "$DIR" 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    echo "ping block removed"
    exit 0 ;;
esac

# on
command -v systemctl >/dev/null || die "systemd is required"
if ! command -v nft >/dev/null; then
  command -v apt-get >/dev/null || die "nft is not installed and apt-get is not available: install nftables first"
  echo "installing nftables..."
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq >/dev/null || echo "warning: apt-get update failed, trying the install anyway" >&2
  apt-get install -y -qq --no-remove nftables >/dev/null || die "could not install nftables"
  hash -r
fi
NFT=$(command -v nft) || die "nft is still not available"

if [ -n "$WAN" ]; then
  IFS_LIST=$(echo "$WAN" | tr ',' ' ' | xargs -n1 2>/dev/null | sort -u | tr '\n' ' ')
  [ -n "${IFS_LIST// /}" ] || die "--wan-if needs at least one interface"
  read -ra IFARR <<<"$IFS_LIST"
  for i in "${IFARR[@]}"; do
    [[ "$i" =~ ^[A-Za-z0-9_.:@-]{1,15}$ ]] || die "bad interface name: $i"
    [ -e "/sys/class/net/$i" ] || echo "warning: interface $i does not exist right now (the rule matches it by name)" >&2
  done
else
  [ -n "$(detect_wan | tr -d ' ')" ] || die "no uplink interface found (no default route); use --wan-if IF"
fi

mkdir -p "$DIR"
if [ -n "$WAN" ]; then printf '%s\n' "${IFARR[*]}" > "$WANFILE"; else rm -f "$WANFILE"; fi

cat > "$APPLY" <<'EOF'
#!/usr/bin/env bash
# generated by block-ping: choose the uplink(s), write the nftables rules, load them.
# Run by block-ping.service at boot, on reload and after "systemctl reload nftables".
set -euo pipefail
export PATH="$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
if [ -s "$dir/wan-if" ]; then
  list=$(tr ',' ' ' < "$dir/wan-if")
else
  list=$({ ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null; } \
    | awk '{for(i=1;i<NF;i++) if($i=="dev") print $(i+1)}' | sort -u | tr '\n' ' ')
fi
[ -n "${list// /}" ] || { echo "block-ping: no uplink interface found (no default route yet)" >&2; exit 1; }
read -ra ifs <<<"$list"
for i in "${ifs[@]}"; do
  [[ "$i" =~ ^[A-Za-z0-9_.:@-]{1,15}$ ]] || { echo "block-ping: bad interface name: $i" >&2; exit 1; }
done
set_text=$(printf '"%s", ' "${ifs[@]}"); set_text=${set_text%, }
cat > "$dir/rules.nft" <<RULES
# generated by block-ping: drops incoming echo requests on: ${ifs[*]}
table inet block_ping
flush table inet block_ping
table inet block_ping {
	chain input {
		type filter hook input priority -10; policy accept;
		iifname { $set_text } icmp type echo-request counter drop
		iifname { $set_text } icmpv6 type echo-request counter drop
	}
}
RULES
nft -c -f "$dir/rules.nft"
nft -f "$dir/rules.nft"
echo "block-ping: ping dropped on: ${ifs[*]}"
EOF
chmod 755 "$APPLY"

cat > "$UNIT" <<EOF
[Unit]
Description=Drop incoming ICMP echo requests on the uplink (block-ping)
After=network-online.target nftables.service
Wants=network-online.target
# "systemctl reload nftables" reloads /etc/nftables.conf, which usually starts with
# "flush ruleset" and would erase our table; reload and restart are passed on to us.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$APPLY
ExecReload=$APPLY
ExecStop=-$NFT delete table $TFAM $TNAME
# The default route can appear a little after boot; try again until the uplink is known.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable block-ping >/dev/null 2>&1
systemctl restart block-ping || die "could not apply the rules; see: journalctl -u block-ping"
if [ -n "$WAN" ]; then
  echo "ping block ACTIVE on: ${IFARR[*]} (also after reboot)"
else
  echo "ping block ACTIVE on the uplink from the default route, re-detected at every start (also after reboot)"
fi
echo "note: ping-based monitoring of this server will report it as down. Undo: block-ping off"
