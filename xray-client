#!/usr/bin/env bash
set -euo pipefail
bundle=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
for module in common state render ownership transaction service clients diagnostics; do
    # shellcheck source=/dev/null
    source "$bundle/lib/$module.sh"
done

usage() {
    printf 'Usage: xray-client help|version|add NAME|list|show NAME [--uri]|export NAME --output FILE|remove NAME|doctor\n'
}

help_text() {
    cat <<'HELP'
xray-client: manage VLESS + REALITY clients (run as root)

  xray-client add NAME                    create a client, print its URI and QR code
  xray-client list                        list clients
  xray-client show NAME                   print the QR code again
  xray-client show NAME --uri             print the URI as text
  xray-client export NAME --output FILE   write the URI to FILE (mode 0600)
  xray-client remove NAME                 revoke a client; that device disconnects
  xray-client doctor                      health report (never prints keys, UUIDs or URIs)
  xray-client version                     kit and Xray-core versions
  xray-client help                        this text

NAME: letters, digits, _ and -. One client per device is recommended.
HELP
}

management_root() {
    local root
    root=$(xvk_client_root_from_bundle "$bundle") || {
        xvk_error 'Management commands require an installed kit'; return 1;
    }
    xvk_require_commands jq || return 1
    printf '%s\n' "${root:-/}"
}

case ${1:-help} in
    help|--help)
        (( $# <= 1 )) || { usage >&2; exit 1; }
        help_text ;;
    version)
        (( $# == 1 )) || exit 1
        xvk_require_commands jq || exit 1
        printf 'xray-vps-kit %s; core %s\n' \
            "$(cat "$bundle/VERSION")" "$(jq -r .version "$bundle/releases/xray.lock.json")" ;;
    add)
        (( $# == 2 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_add "$root" "$2" ;;
    remove)
        (( $# == 2 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_remove "$root" "$2" ;;
    list)
        (( $# == 1 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_list "$root" ;;
    show)
        (( $# == 2 || $# == 3 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        case ${3:-} in
            '') xvk_client_show_qr "$root" "$2" ;;
            --uri) xvk_client_show "$root" "$2" --uri ;;
            *) usage >&2; exit 1 ;;
        esac ;;
    export)
        if (( $# != 4 )) || [[ $3 != --output ]]; then usage >&2; exit 1; fi
        root=$(management_root) || exit 1
        xvk_client_export "$root" "$2" "$4" ;;
    doctor)
        (( $# == 1 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_doctor "$root" ;;
    *) usage >&2; exit 1 ;;
esac
