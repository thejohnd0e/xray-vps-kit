#!/usr/bin/env bash
set -euo pipefail
bundle=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
for module in common state render ownership firewall transaction service clients diagnostics; do
    # shellcheck source=/dev/null
    source "$bundle/lib/$module.sh"
done

usage() {
    printf 'Usage: xray-client help|version|add NAME|list|show NAME|export NAME --output FILE|remove NAME|doctor|ipv6|recover\n'
}

help_text() {
    cat <<'HELP'
xray-client: manage VLESS + REALITY clients (run as root)

  xray-client add NAME [--fp FP]          create a client, print its URI and QR code
  xray-client list [--json]               list clients (names only)
  xray-client show NAME [--fp FP]         print the URI and QR code again (URI to a file: export)
  xray-client export NAME --output FILE [--fp FP] [--format uri|singbox|clash]
                                          write the profile to FILE (mode 0600); singbox is one
                                          sing-box outbound, clash a Clash Meta proxies list
  xray-client remove NAME                 revoke a client; that device disconnects
  xray-client doctor [--probe-target] [--probe-reality]
                                          health report (never prints keys, UUIDs or URIs);
                                          --probe-target asks the REALITY target for TLS 1.3,
                                          --probe-reality dials this server with a throwaway client
  xray-client ipv6 on|off                 manage IPv6 reachability (UFW IPv6 rule, doctor check); restarts the service
  xray-client recover                     undo a change that was cut short by a crash or power loss
  xray-client version                     kit and Xray-core versions
  xray-client help                        this text

NAME: letters, digits, _ - @ and . (e.g. an email). One client per device is recommended.
FP: TLS fingerprint written into the URI (chrome, firefox, safari, ios, android, edge, random,
randomized; default chrome). It is a client-side setting, stored nowhere: pass it again for each
output. Try firefox if a client connects only part of the time.
HELP
}

# Sets fp from an optional trailing "--fp VALUE"; fails on any other extra argument.
parse_fp() {
    fp=chrome
    case $# in
        0) ;;
        2) [[ $1 == --fp ]] || return 1; fp=$2 ;;
        *) return 1 ;;
    esac
    xvk_validate_fp "$fp" || { xvk_error "Invalid fingerprint '$fp' (see xray-client help)"; return 1; }
}

# Optional trailing "--fp VALUE" and "--format VALUE" (each at most once, any order).
parse_export_options() {
    fp=chrome format=uri
    local seen_fp=false seen_format=false
    while (( $# )); do
        (( $# >= 2 )) || return 1
        case $1 in
            --fp) [[ $seen_fp == false ]] || return 1; seen_fp=true; fp=$2 ;;
            --format) [[ $seen_format == false ]] || return 1; seen_format=true; format=$2 ;;
            *) return 1 ;;
        esac
        shift 2
    done
    xvk_validate_fp "$fp" || { xvk_error "Invalid fingerprint '$fp' (see xray-client help)"; return 1; }
    case $format in uri|singbox|clash) ;; *) xvk_error "Invalid format '$format' (uri, singbox, clash)"; return 1 ;; esac
}

management_root() {
    local root
    root=$(xvk_client_root_from_bundle "$bundle") || {
        xvk_error 'Management commands require an installed kit'; return 1;
    }
    xvk_require_commands jq || return 1
    printf '%s\n' "${root:-/}"
}

case ${1:-help} in
    help|--help)
        (( $# <= 1 )) || { usage >&2; exit 1; }
        help_text ;;
    version)
        (( $# == 1 )) || exit 1
        xvk_require_commands jq || exit 1
        printf 'xray-vps-kit %s; core %s\n' \
            "$(cat "$bundle/VERSION")" "$(jq -r .version "$bundle/releases/xray.lock.json")" ;;
    add)
        (( $# == 2 || $# == 4 )) || { usage >&2; exit 1; }
        parse_fp "${@:3}" || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_mutate "$root" add "$2" && xvk_client_print_profile "$root" "$2" "$fp" ;;
    remove)
        (( $# == 2 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_remove "$root" "$2" ;;
    list)
        (( $# == 1 )) || [[ $# == 2 && $2 == --json ]] || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        if (( $# == 2 )); then xvk_client_list_json "$root"; else xvk_client_list "$root"; fi ;;
    show)
        (( $# == 2 || $# == 4 )) || { usage >&2; exit 1; }
        parse_fp "${@:3}" || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_print_profile "$root" "$2" "$fp" ;;
    export)
        if (( $# < 4 || $# > 8 || $# % 2 )) || [[ $3 != --output ]]; then usage >&2; exit 1; fi
        parse_export_options "${@:5}" || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_export "$root" "$2" "$4" "$fp" "$format" ;;
    ipv6)
        (( $# == 2 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_ipv6 "$root" "$2" ;;
    recover)
        (( $# == 1 )) || { usage >&2; exit 1; }
        root=$(management_root) || exit 1
        xvk_client_recover "$root" ;;
    doctor)
        for option in "${@:2}"; do
            [[ $option == --probe-target || $option == --probe-reality ]] || { usage >&2; exit 1; }
        done
        root=$(management_root) || exit 1
        xvk_client_doctor "$root" "${@:2}" ;;
    *) usage >&2; exit 1 ;;
esac
